<?xml version="1.0" encoding="UTF-8"?>
<!--
  Kifaa Agent MSI — file installer (wixl 0.101+ compatible)

  Installs kifaa-setup-helper.exe to Program Files\KifaaAgent\
  The deploy engine runs it in a chained command:
    msiexec /i kifaa.msi /qn /norestart
    then: kifaa-setup-helper.exe -server ... -secret ...

  Build: bash build-msi.sh
  Properties (for reference, used by deploy engine):
    SERVERURL  — Kifaa server URL
    SECRET     — registration secret
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product Id="*"
           Name="Kifaa Agent"
           Language="1033"
           Version="1.3.1"
           Manufacturer="Kifaa Platform"
           UpgradeCode="E4A7B2C1-3D5F-4E89-A012-1B3C5D7E9F01">

    <Package InstallerVersion="200"
             Compressed="yes"
             Description="Kifaa Endpoint Monitoring and Management Agent"
             Comments="Deploy: msiexec /i kifaa.msi /qn SERVERURL=https://... SECRET=..." />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Kifaa Agent is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- ── Directory layout ────────────────────────────────────────────── -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="KifaaAgent" />
      </Directory>
    </Directory>

    <!-- ── Feature: install the silent setup helper ─────────────────────── -->
    <Feature Id="ProductFeature" Title="Kifaa Agent" Level="1">
      <ComponentRef Id="SetupHelper" />
    </Feature>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="SetupHelper" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
        <File Id="InstallerExe"
              Source="$(var.InstallerBin)"
              Name="kifaa-setup-helper.exe"
              KeyPath="yes" />
      </Component>
    </DirectoryRef>

  </Product>
</Wix>
