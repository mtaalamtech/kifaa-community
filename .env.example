# ─────────────────────────────────────────────────────────────────────────────
# Kifaa Community Edition — Environment Configuration
# Copy this file to .env and fill in your values before first run.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
# IP address or hostname that agents will use to reach this server.
# This is baked into the agent installer URL shown in the UI.
SERVER_IP=192.168.1.10

# Optional: public domain name for HTTPS (leave blank to use IP only)
SERVER_DOMAIN=kifaa.example.com

# ── Security (CHANGE ALL OF THESE before first run) ──────────────────────────
# JWT signing key — minimum 32 characters, random string
SECRET_KEY=change-me-use-a-long-random-string-here-32chars

# Key used to authenticate agent registration requests
AGENT_REGISTRATION_KEY=change-me-agent-registration-key

# Database password
DB_PASSWORD=change-me-strong-database-password

# Fernet encryption key for stored secrets (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=change-me-generate-with-fernet

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=kifaa
POSTGRES_USER=kifaa
# POSTGRES_HOST is set automatically to 'timescaledb' inside Docker

# ── Email Notifications ───────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_TLS=true
ALERT_FROM=kifaa-alerts@example.com
# Comma-separated list of default alert recipients
ALERT_EMAIL=admin@example.com

# ── Application ───────────────────────────────────────────────────────────────
# Token expiry in minutes (default: 480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Agent heartbeat timeout in minutes — agent marked offline after this
AGENT_OFFLINE_THRESHOLD_MINUTES=5

# Backup settings
BACKUP_HOUR=2            # Hour (UTC) to run daily backup (0-23)
BACKUP_RETENTION_DAYS=7  # How many days of backups to keep

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Reporting ─────────────────────────────────────────────────────────────────
# Company name shown in PDF/Excel report headers
COMPANY_NAME=Your Company Name
COMPANY_LOGO_URL=
